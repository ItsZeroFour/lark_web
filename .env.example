# Public site URL — used for canonical links, Open Graph, sitemap and robots.
# Set this to the real domain (with https://, no trailing slash) once it is
# live. Until then a placeholder domain is used so builds keep working.
NEXT_PUBLIC_SITE_URL=https://larkfreelance.dev

# Larkins AI — Claude integration
# Optional. Without a key, the Larkins console runs a fully working
# scripted brief flow. With a key, replies are generated live by Claude.
ANTHROPIC_API_KEY=

# Model used for the Larkins assistant (optional override)
ANTHROPIC_MODEL=claude-opus-4-7
